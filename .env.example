# ---------------------------------------------------------------
# مجتمعات تصميم — environment template (no secret values here)
# Copy to .env.local for local development. Never commit .env.local.
# ---------------------------------------------------------------

# Public site URL (used in e-mail verification / password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used for:
#  * short-lived signed download URLs for approved files
#  * executing approved account-deletion requests
#  * the one-time initial administrator bootstrap script
SUPABASE_SERVICE_ROLE_KEY=
